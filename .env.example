# Copiá este archivo a .env.local para desarrollo, y cargá los mismos valores
# en Vercel → Project Settings → Environment Variables para producción.
# Ninguno de estos valores es secreto: son IDs públicos que terminan
# viviendo en el HTML/JS del sitio de todas formas.

# Google Analytics 4 — Measurement ID (Admin → Data streams → tu stream web)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — Project ID (Settings → Overview)
NEXT_PUBLIC_CLARITY_ID=
